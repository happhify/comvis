# Salin file ini ke ".env" lalu isi dengan alamat kamera asli.
# "docker compose" otomatis membaca ".env" di root untuk service "worker".
#
# Setiap kamera di config/camera.yaml (cameras.list) menunjuk ke SATU
# variabel di sini lewat "rtsp_env_key". Kamera pertama sudah dipetakan
# ke RTSP_URL biasa; untuk kamera tambahan, buat variabel baru
# (RTSP_URL_2, RTSP_URL_3, dst) lalu daftarkan id+nama+env key-nya di
# config/camera.yaml.
RTSP_URL=rtsp://user:password@192.168.1.100:554/stream1
# RTSP_URL_2=rtsp://user:password@192.168.1.101:554/stream1
# RTSP_URL_3=rtsp://user:password@192.168.1.102:554/stream1
